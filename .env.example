# Path to the Google service account JSON key. Never commit this file.
GOOGLE_APPLICATION_CREDENTIALS=./secrets/service-account.json

# Upstream target that receives the requests
TARGET_URL=https://apigee.googleapis.com

# Where the proxy listens
HOST=127.0.0.1
PORT=8080

# Comma-separated OAuth2 scopes
GOOGLE_SCOPES=https://www.googleapis.com/auth/cloud-platform

# Optional: impersonate a user with domain-wide delegation
# GOOGLE_IMPERSONATE_SUBJECT=user@example.com

# Optional: expose the proxy under a prefix (the prefix is stripped before forwarding)
# BASE_PATH=/apigee

# Optional: only forward requests whose path starts with one of these prefixes.
# A "*" matches a single path segment (handy for the Apigee org name).
# The example below is GET-only read access to API proxies (including revision
# bundles via ?format=bundle), API products, deployments and target servers.
# ALLOWED_PATH_PREFIXES=/v1/organizations/*/apis,/v1/organizations/*/apiproducts,/v1/organizations/*/deployments,/v1/organizations/*/environments/*/deployments,/v1/organizations/*/environments/*/apis/*/deployments,/v1/organizations/*/environments/*/apis/*/revisions/*/deployments,/v1/organizations/*/environments/*/targetservers

# Optional: only allow these HTTP methods (comma-separated). Empty means all.
# Disallowed methods receive 405 and disallowed paths receive 403.
# ALLOWED_METHODS=GET

# Optional: networking and logging
PROXY_TIMEOUT_MS=60000
TARGET_TLS_VERIFY=true
LOG_REQUESTS=true
